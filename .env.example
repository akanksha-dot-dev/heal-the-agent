# 1) Get a free key: https://aistudio.google.com/apikey   2) copy this file to .env   3) paste it below
GOOGLE_API_KEY=paste-your-key-here
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# Cloud model names change every few months. `python check_setup.py` tests candidates for you.
AGENT_MODEL=gemini-flash-lite-latest

# The "doctor" cascade: a failed attempt escalates to the next entry (comma-separated).
#   default (cloud only):            gemini-flash-lite-latest
#   local first, cloud as backup:    ollama/gemma4:e4b,gemini-flash-lite-latest
#   wifi-proof (recording as last):  gemini-flash-lite-latest,replay
DOCTOR_CASCADE=gemini-flash-lite-latest
MAX_ATTEMPTS=3
